<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/scope_hint"
            style="@style/SettingsHint" />

        <!-- Board -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/board" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Top N -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/top_n" />

        <EditText
            android:id="@+id/top_n"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:hint="@string/top_n_default"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:selectAllOnFocus="true" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/top_n_hint" />

        <!-- Post-game delay -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/post_game_delay" />

        <EditText
            android:id="@+id/post_game_delay"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:hint="@string/post_game_delay_default"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3"
            android:selectAllOnFocus="true" />

        <!-- Background -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/background_opacity" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/opacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/opacity_value"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/board_opacity" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/board_opacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/board_opacity_value"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <Button
            android:id="@+id/done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save_widget" />

        <!-- Advanced -->
        <Button
            android:id="@+id/advanced_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/show_advanced" />

        <LinearLayout
            android:id="@+id/advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/version"
                style="@style/SettingsHint" />

            <TextView
                android:id="@+id/service_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/start"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/start" />

                <Button
                    android:id="@+id/stop"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/stop" />
            </LinearLayout>

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/server" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/server"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/server_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/save_server"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/protocol_log" />

                <Button
                    android:id="@+id/share_log"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share_log" />
            </LinearLayout>

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
