<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetText">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetText.Strong">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFD27A</item>
    </style>

    <style name="WidgetText.Clock">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Medium</item>
    </style>

    <style name="SettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Small</item>
        <item name="android:alpha">0.7</item>
    </style>
</resources>
